const nav = [
  { href: `${import.meta.env.BASE_URL}`, label: "Home" },
  { href: `${import.meta.env.BASE_URL}blog`, label: "Blog" },
  { href: `${import.meta.env.BASE_URL}about`, label: "About" },
];
---

<header class="border-b border-doom-base4">
  <nav class="max-w-3xl mx-auto flex items-center justify-between px-4 py-4">
    <a href="/" class="font-bold text-2xl tracking-wide text-doom-blue">
      Cyber Site
    </a>
    <ul class="flex gap-6 text-sm text-doom-base6">
      {
        nav.map((item) => (
          <li>
            
            <a href={item.href}
              class="font-medium tracking-wide hover:text-doom-cyan active:text-doom-cyan transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
