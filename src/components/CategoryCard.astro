---
import { categoryStyle } from "../lib/CategoryColors";

interface Props {
    category: string;
    count: number;
}

const { category, count } = Astro.props;
---

<a
    href={`/blog/${category}/posts`}
    class={`group block rounded-lg border ${categoryStyle.border} bg-doom-base1 p-5 transition-all duration-200 ease-in-out ${categoryStyle.hover} hover:bg-doom-base2 hover:scale-105 hover:shadow-lg hover:shadow-black/40 active:scale-105 active:bg-doom-base2 active:shadow-lg active:shadow-black/40`}
>
    <h3 class={`text-lg font-semibold capitalize ${categoryStyle.text}`}>
        {category}
    </h3>
    <p class="text-sm-text-doom-base6 mt-1">
        {count} post{count === 1 ? "" : "s"}
    </p>
</a>
