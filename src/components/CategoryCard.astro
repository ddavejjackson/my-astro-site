---
import { categoryStyles, defaultCategoryStyle } from "../lib/CategoryColors";

interface Props {
    category: string;
    count: number;
}

const { category, count } = Astro.props;
const style = categoryStyles[category] ?? defaultCategoryStyle;
---

<a
    href={`/blog/${category}/posts`}
    class={`group block rounded-lg border ${style.border} bg-doom-base1 p-5 transition-colors ${style.hover} hover:bg-doom-base2`}
>
    <h3 class={`text-lg font-semibold capitalize ${style.text}`}>{category}</h3>
    <p class="text-sm text-doom-base6 mt-1">
        {count} post{count === 1 ? "" : "s"}
    </p>
</a>
