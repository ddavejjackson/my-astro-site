---
import BaseLayout from '../layouts/BaseLayout.astro';

const profilePicture =
  'https://scontent.cdninstagram.com/v/t51.82787-19/641760501_18361897759206212_3359924725507207818_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=cflbznMVRoYQ7kNvwHh3jGK&_nc_oc=AdoD0BQXOlXUVIHvBRljxBubpYe5qf9UZo4xRdwn4wfcLd01MwJqZXh4TXI-8kpkjkw5pI03TkzrPAAQCWXbFX2X&_nc_zt=24&_nc_ht=scontent.cdninstagram.com&_nc_gid=ObD6BbMjy4dkTWNh-l-rNA&_nc_ss=7b689&oh=00_AQFIecODH9kimvx_aUa_CYavY_ud0uZVU061kZijQkRjLg&oe=6A83B5BE';

const name = 'Cyber';
---

<BaseLayout title="About">
  <div class="max-w-3xl mx-auto">
    <div
      class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-10"
    >
      <img
        src={profilePicture}
        alt="Photo of Your Name"
        class="w-36 h-36 sm:w-44 sm:h-44 rounded-full object-cover border-4 border-doom-blue shadow-lg shadow-doom-blue/20 shrink-0"
      />
      <div class="text-center sm:text-left">
        <h1 class="text-3xl font-bold text-doom-blue mb-1">{name}</h1>
        <p class="text-doom-cyan mb-4">
          Developer &middot; Writer &middot; Whatever fits
        </p>
        <div class="flex justify-center sm:justify-start gap-4 text-sm">
          <a
            href="https://github.com/yourusername"
            class="text-doom-blue
          hover:text-doom-cyan transition-colors"
            >GitHub
          </a>

          <a
            href="https://twitter.com/yourusername"
            class="text-doom-blue
        hover:text-doom-cyan transition-colors"
            >Twitter
          </a>

          <a
            href="mailto:you@example.com"
            class="text-doom-blue
          hover:text-doom-cyan transition-colors"
            >Email
          </a>
        </div>
      </div>

      <div
        class="prose prose-invert max-w-none
            prose-headings:text-doom-blue
            prose-a:text-doom-cyan prose-a:no-underline hover:prose-a:underline
            prose-strong:text-doom-orange"
      >
        <p>
          Hi, I'm Your Name — welcome to my corner of the internet. I write
          about <strong>[topics you cover]</strong> and build things on the side.
        </p>
        <p>
          This blog is built with Astro and Tailwind CSS v4, demonstrating
          content collections, markdown styling with the typography plugin, and
          tag-based filtering.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
