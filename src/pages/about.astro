---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <div
        class="prose prose-invert max-w-none
    prose-headings:text-doom-blue
    prose-a:text-doom-cyan prose-a:no-underline hover:prose-a:underline
    prose-strong:text-doom-orange"
    >
        <h1>About</h1>
        <p>
            This is a blog built with Astro and Tailwind CSS v4, demonstrating
            content collections, markdown styling with the typography plugin,
            and tag-based filtering.
        </p>
    </div>
</BaseLayout>
