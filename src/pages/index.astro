---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import GradientHero from "../components/GradientHero.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
const postCount = posts.length;
const categoryCount = new Set(posts.map((post) => post.data.category)).size;
const sinceYear = posts.length
    ? Math.min(...posts.map((post) => post.data.pubDate.getFullYear()))
    : new Date().getFullYear();

const quickLinks = [
    { name: "GitHub", url: "https://github.com" },
    { name: "YouTube", url: "https://youtube.com" },
    { name: "Reddit", url: "https://reddit.com" },
    { name: "Astro Docs", url: "https://docs.astro.build" },
    { name: "Twitter/X", url: "https://x.com" },
    { name: "Portfolio", url: "/about" },
];
---

<BaseLayout title="Home">
    <!-- Hero: full-width, manages its own inner max-width and glow -->
    <GradientHero
        postCount={postCount}
        categoryCount={categoryCount}
        sinceYear={sinceYear}
    />

    <!-- Search -->
    <section class="max-w-3xl mx-auto mb-16">
        <SearchBar />
    </section>

    <!-- Quick Links: dashboard grid -->
    <section class="max-w-3xl mx-auto">
        <div class="flex items-center gap-4 mb-6">
            <h2
                class="text-sm uppercase tracking-widest font-bold text-doom-base6"
            >
                Quick Access
            </h2>
            <div class="h-px flex-1 bg-doom-base3"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {
                quickLinks.map((link) => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative overflow-hidden p-4 rounded-lg border border-doom-base3 bg-doom-base1 text-doom-fg transition-all duration-200 ease-in-out hover:border-doom-base4 hover:bg-doom-base2 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/40 hover:text-doom-blue active:border-doom-base4 active:bg-doom-base2 active:-translate-y-1 active:shadow-lg active:shadow-black/40 active:text-doom-blue"
                    >
                        {/* Accent line: left bar, fills with current text color on hover/press */}
                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-transparent group-hover:bg-current group-active:bg-current transition-colors duration-200" />
                        <div class="flex items-center justify-between">
                            <span class="font-medium tracking-wide">
                                {link.name}
                            </span>
                            <span class="text-xs opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity duration-200">
                                ↗
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
